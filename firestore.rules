rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get user profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if user belongs to the couple of the resource
    function belongsToCouple(coupleId) {
      return getUserData().coupleId == coupleId;
    }

    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users:
    // - Read: Own profile OR partner's profile (same coupleId) OR admin
    // - Write: Own profile only (cannot set own role) OR admin
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || resource.data.coupleId == getUserData().coupleId
        || isAdmin()
      );
      allow write: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == userId && !('role' in request.resource.data);
    }

    // Couples:
    // - Create: Any auth user
    // - Read: Any auth user (needed to check couple code for joining) OR admin
    // - Update: Any auth user OR admin
    // - Delete: Admin only
    match /couples/{coupleId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Goals:
    // - Read/Write if the user's coupleId matches the goal's coupleId OR admin
    match /goals/{goalId} {
      allow create: if request.auth != null && (belongsToCouple(request.resource.data.coupleId) || isAdmin());
      allow read, update, delete: if request.auth != null && (belongsToCouple(resource.data.coupleId) || isAdmin());

      // Checkins (Subcollection):
      match /checkins/{checkinId} {
        allow read: if request.auth != null && (
          belongsToCouple(get(/databases/$(database)/documents/goals/$(goalId)).data.coupleId)
          || isAdmin()
        );
        allow write: if request.auth != null
                     && belongsToCouple(get(/databases/$(database)/documents/goals/$(goalId)).data.coupleId)
                     && request.resource.data.uid == request.auth.uid;
      }
    }

    // Love Tests:
    match /loveTests/{testId} {
      allow create: if request.auth != null && (belongsToCouple(request.resource.data.coupleId) || isAdmin());
      allow read, update: if request.auth != null && (belongsToCouple(resource.data.coupleId) || isAdmin());
    }
  }
}
